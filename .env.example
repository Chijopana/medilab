# Copia este fichero a `.env` y ajusta los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.
#
# En desarrollo puedes dejarlo todo por defecto y ni siquiera crear el .env:
# si no hay SECRET_KEY y DEBUG=True, se genera una clave temporal al arrancar.

# --- Básico ---
DEBUG=True
# Obligatoria si DEBUG=False. Genérala con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Dominios de confianza para CSRF (solo si sirves detrás de un dominio/HTTPS)
# CSRF_TRUSTED_ORIGINS=https://medilab.example.com

# --- Base de datos ---
# Por defecto SQLite en la raíz del proyecto. Para PostgreSQL en producción:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=medilab
# DB_USER=medilab
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Subidas ---
# Tamaño máximo, en bytes, de las imágenes del diagnóstico por IA (10 MB)
MAX_UPLOAD_SIZE=10485760

# --- Seguridad en producción ---
# Estas tres solo se aplican cuando DEBUG=False; ahí valen True por defecto.
# Ponlas a False únicamente si sirves sin HTTPS (no recomendado).
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
